# Copy to .env.local for development; on Vercel set these in Project Settings -> Environment Variables.

# Backend base URL (https:// in production - browsers block http:// APIs from https:// pages)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Require a blink before face login (set to false only for demos)
# NEXT_PUBLIC_REQUIRE_BLINK=true

# Try ONNX Runtime's WebGPU backend first (bigger runtime download)
# NEXT_PUBLIC_EMBEDDING_WEBGPU=false
