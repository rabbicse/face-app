# Copy to .env next to docker-compose.yml (all optional)

# Docker Hub user/org that publishes the images (<namespace>/frs-api, <namespace>/frs-web).
# Leave empty to build the images from this repository instead.
FRS_IMAGE_NAMESPACE=
FRS_TAG=latest

FRS_WEB_PORT=3000
FRS_API_PORT=5000
FRS_WORKERS=2
FRS_MATCH_THRESHOLD=0.45
FRS_MATCH_MARGIN=0.05
